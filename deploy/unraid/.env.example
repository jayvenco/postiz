# Copy this file to .env in the same folder and fill in real values before running install.sh.
# This .env is only used by docker-compose.yaml here in deploy/unraid — do not confuse it with
# the repo root .env used for local development.

# === Required Settings
# Generate with: openssl rand -hex 32
JWT_SECRET=""

# The IP or domain you'll use to reach Postiz. If you later put this behind a
# reverse proxy with a real domain (e.g. Nginx Proxy Manager / SWAG), change
# these three to that domain instead.
MAIN_URL="http://192.168.2.200:4007"
FRONTEND_URL="http://192.168.2.200:4007"
NEXT_PUBLIC_BACKEND_URL="http://192.168.2.200:4007/api"

BACKEND_INTERNAL_URL="http://localhost:3000"
TEMPORAL_ADDRESS="temporal:7233"
IS_GENERAL="true"
DISABLE_REGISTRATION="false"

# === Database (used by both postiz and postiz-postgres containers)
POSTGRES_USER="postiz-user"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="postiz-db-local"
DATABASE_URL="postgresql://postiz-user:change-me-to-a-strong-password@postiz-postgres:5432/postiz-db-local"
REDIS_URL="redis://postiz-redis:6379"

# === Storage Settings
STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_DIRECTORY="/uploads"

# === Common optional Settings
#RESEND_API_KEY=""
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""

# === Social Media API Settings (fill in the ones you plan to use)
X_URL=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# === Misc Settings
OPENAI_API_KEY=""
API_LIMIT=30

# === Payment / Stripe Settings (leave blank if unused)
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_SIGNING_KEY_CONNECT=""

# === Developer Settings
NX_ADD_PLUGINS="false"
